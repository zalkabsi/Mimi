# Copy this file to .env and fill in credentials locally.
# Never commit .env or paste provider keys into chat.
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
TAVILY_API_KEY=
MIMI_JUDGE_KEY=
# Comma-separated browser origins allowed to call the API.
MIMI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional settings
MIMI_DB_PATH=mimi.db
# MIMI_FORCE_MODEL=nano
# SANDBOXES_BASE_URL=https://api.sandbox.nebius.ai/v1
